# Скопируйте в .env и заполните

# Название сервера — его видно в приложении при входе
SERVER_NAME=KMP Music

# Cloudflare Tunnel: раскомментируйте обе строки, когда получите токен
# (панель Cloudflare Zero Trust → Networks → Tunnels → ваш туннель → Install connector)
#COMPOSE_PROFILES=tunnel
#TUNNEL_TOKEN=
