# Скопируйте в .env и заполните

# Название сервера — его видно в приложении при входе
SERVER_NAME=KMP Music

# Tailscale Funnel (рекомендуется, домен не нужен): ключ из панели Tailscale → Settings → Keys.
# Ключ — не Ephemeral и без тегов. Запуск: docker compose -f docker-compose.yml -f docker-compose.tailscale.yml up -d
TS_AUTHKEY=
# Имя устройства — первая часть адреса https://<имя>.tailXXXX.ts.net
#TS_HOSTNAME=kmp-music

# Cloudflare Tunnel (нужен свой домен): раскомментируйте обе строки, когда получите токен
# (панель Cloudflare → Networking → Tunnels → ваш туннель → Install and Run)
#COMPOSE_PROFILES=tunnel
#TUNNEL_TOKEN=

# DNS для коннектора туннеля. Если туннель не подключается с ошибкой про
# "_v2-origintunneld._tcp.argotunnel.com", укажите DNS своего роутера (например, 192.168.1.1)
#TUNNEL_DNS=1.1.1.1
